# Camp CRM — Environment Variables

# Secret per Auth.js (generane uno con: openssl rand -base64 32)
AUTH_SECRET=cambia-questo-con-una-stringa-lunga-e-casuale

# Chiave di cifratura dei documenti d'identità a riposo (AES-256-GCM).
# Genera con: openssl rand -base64 32
# ATTENZIONE: se la perdi, tutti i documenti salvati diventano illeggibili.
# Tientila fuori dal volume dei dati e dal repo git (es. password manager).
DOCUMENT_ENCRYPTION_KEY=

# ── Privacy / GDPR ───────────────────────────────────────────────
# Titolare del trattamento (mostrato nella pagina /privacy).
DATA_CONTROLLER_NAME=Mario Rossi
# Email di contatto per le richieste dei diritti dell'interessato.
DATA_CONTROLLER_EMAIL=privacy@tuodominio.it

# Periodo di conservazione dei dati (mesi) dopo la fine dell'evento.
# Usato dalla pagina /privacy e dallo script npm run retention:purge.
RETENTION_MONTHS=24

# Percorso del database SQLite
# Sviluppo locale: file:./dev.db
# Docker: file:./data/dev.db
DATABASE_URL=file:./dev.db

# Credenziali iniziali (seed) — opzionali, con valori di default.
# Usate SOLO se l'utente non esiste già nel DB; il seed non sovrascrive
# utenti esistenti. In Docker impostale come env var in docker-compose.yml.
SEED_ADMIN_EMAIL=admin@camp.it
SEED_ADMIN_NAME=Amministratore
SEED_ADMIN_PASSWORD=admin123
SEED_STAFF_EMAIL=staff@camp.it
SEED_STAFF_NAME=Operatore
SEED_STAFF_PASSWORD=staff123
